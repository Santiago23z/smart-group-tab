# Local Postgres 17, installed with: brew install postgresql@17
# Started with:                      brew services start postgresql@17
# Database created with:             createdb smart_group_tab
DATABASE_URL=postgres://santiagozapata@localhost:5432/smart_group_tab

# psql and friends are not on PATH by default with a versioned formula:
#   export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

# --- Wompi ------------------------------------------------------------------
# THESE ARE TWO DIFFERENT SECRETS AND THEY ARE NOT INTERCHANGEABLE.
#
#   events secret     verifies webhooks arriving FROM Wompi
#   integrity secret  signs the charge we send TO Wompi
#
# Swapping them fails in a way that reads like a key rotation problem: checkouts
# are rejected at Wompi's end and webhooks fail signature here, with nothing
# pointing at the actual cause. Both live under Developers in the dashboard.
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_PUBLIC_KEY=pub_test_...

# Sandbox: https://checkout.wompi.co/p/  (the same host; the key decides the env)
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# Where Wompi sends the diner after paying. Must be reachable from their phone.
WOMPI_REDIRECT_URL=

PORT=8787
