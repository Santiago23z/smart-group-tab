# Local Postgres 17, installed with: brew install postgresql@17
# Started with:                      brew services start postgresql@17
# Database created with:             createdb smart_group_tab
DATABASE_URL=postgres://santiagozapata@localhost:5432/smart_group_tab

# psql and friends are not on PATH by default with a versioned formula:
#   export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

# --- Wompi ------------------------------------------------------------------
# THESE ARE TWO DIFFERENT SECRETS AND THEY ARE NOT INTERCHANGEABLE.
#
#   events secret     verifies webhooks arriving FROM Wompi
#   integrity secret  signs the charge we send TO Wompi
#
# Swapping them fails in a way that reads like a key rotation problem: checkouts
# are rejected at Wompi's end and webhooks fail signature here, with nothing
# pointing at the actual cause. Both live under Developers in the dashboard.
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_PUBLIC_KEY=pub_test_...

# Sandbox: https://checkout.wompi.co/p/  (the same host; the key decides the env)
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# Where Wompi sends the diner after paying. Only its origin is used by `npm run
# web`: the diner lands on /t/<their table> there. Empty = the address the phone
# used to reach us. Wompi blocks the whole checkout when this is an IP address
# or localhost, so such an origin is left out (no way back; the periodic check
# still finds the payment). Open the app by name, e.g. http://<mac>.local:8788.
WOMPI_REDIRECT_URL=

# Reconciliation: asking Wompi about payments whose webhook never arrived. The
# private key never leaves the server. Empty = off; payments still arrive by
# webhook, we just cannot go looking for the ones that don't.
WOMPI_PRIVATE_KEY=
# The key decides the environment; use https://production.wompi.co/v1 with prv_prod_.
WOMPI_API_URL=https://sandbox.wompi.co/v1
# How often `npm run wompi` checks unsettled checkouts (issued in the last 24 h).
WOMPI_RECONCILE_SECONDS=60

# --- Dispatch worker -------------------------------------------------------
# Where a released round's ticket is delivered, per channel. BOTH are required:
# every dispatched round enqueues a `kds` row and a `print` row, and a channel
# with no destination leaves its rows pending forever — indistinguishable from a
# stuck delivery, which is the one signal the worker exists to give.
#
# Both point at the kitchen display (`npm run kds`). Until a real printer exists,
# the KDS acknowledges the print channel and logs it.
DISPATCH_KDS_URL=http://localhost:8790/ingest/kds
DISPATCH_PRINT_URL=http://localhost:8790/ingest/print

# How often the worker looks for due rows.
DISPATCH_POLL_MS=2000

# Shared by the worker (sends it) and the KDS (checks it). Without it, anyone on
# the venue network could put unpaid food on the kitchen screen. Both refuse to
# start when it is missing. Any long random string: openssl rand -hex 24
DISPATCH_TOKEN=

# --- Kitchen display ---------------------------------------------------------
# Opens the staff screen: http://<host>:8790/kds#token=<KDS_STAFF_TOKEN>
# A different secret from DISPATCH_TOKEN on purpose: the one on the tablet is not
# the one that can inject tickets.
KDS_STAFF_TOKEN=
KDS_PORT=8790

# Minutes a due dispatch may wait before the screen warns the worker is down.
KDS_STALL_MINUTES=2

PORT=8787
